<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>List of students</title>
    <style>

    body {
         background-color: #e6f4f1;
        }

    table {
        border-collapse: collapse;
        width: 70%;
        margin: 0 auto;
        margin-top: 5%;
        background-color: #ffffff;
    }

    table, th, td {
        border: 1px solid #0f766e;
    }

    th {
        background-color: #0f766e;
        color: white;
    }

    th, td {
        padding: 10px;
        text-align: left;
    }

    a {
        color: #f97316;
        font-weight: bold;
        text-decoration: none;
    }

    .back {
        display: block;
        width: 70%;
        margin: 20px auto 0;
        color: #0f766e;
    }

</style>
</head>
<body>
    <a href="/" class="back">&larr; Back to Home</a>

    <table>
        <thead>
            <tr>
                <th>Student ID</th>
                <th>Firstname</th>
                <th>Lastname</th>
                <th>Age</th>
                <th>Address</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            <%
                if(student.length > 0){
                    student.forEach((data, index)=>{

        
            %>
            <tr>
                <td><%=  index + 1  %></td>
                <td><%=  data.firstname  %></td>
                <td><%=  data.lastname  %></td>
                <td><%=  data.age  %></td>
                <td><%=  data.address  %></td>
                <td> <a href="/delete/<%= data.student_id %>" onclick="return confirm('Do you want to delete this account?')"> Delete </a> </td>
            </tr>
            <%
                     })
                }
            %>
        </tbody>
    </table>
    
</body>
</html>